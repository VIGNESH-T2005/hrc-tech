{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HrcTech",
    "Audience": "HrcTech.Client",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "RefreshCookieName": "hrc_refresh",
    "RefreshCookieSecure": true,
    "RefreshCookieSameSite": "Lax"
  },
  "RateLimiting": {
    "StrictPerMinute": 10,
    "RefreshPerMinute": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": false
  }
}