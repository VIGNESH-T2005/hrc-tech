{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HrcTech",
    "Audience": "HrcTech.Client",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "RefreshCookieName": "hrc_refresh",
    "RefreshCookieSecure": true,
    "RefreshCookieSameSite": "Lax"
  },
  "RateLimiting": {
    "StrictPerMinute": 10,
    "RefreshPerMinute": 30,
    "ContentStreamPerMinute": 120
  },
  "Processing": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "WatermarkFontPath": "",
    "VideoTimeoutMinutes": 120,
    "MaxVideoMinutes": 240,
    "MaxVideoPixels": 8294400,
    "MaxPdfPages": 1000,
    "VideoCrf": 23
  },
  "ContentAccess": {
    "TokenMinutes": 5,
    "VideoCompletionThresholdPercent": 90
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": false
  }
}